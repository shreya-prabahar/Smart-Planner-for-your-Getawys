/* =========================
   GENERAL STYLING
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f7f9;
    color: #333;
    line-height: 1.6;
}


/* =========================
   HEADER
========================= */

header {
    background: linear-gradient(90deg, #2196f3, #12b8b0);
    color: white;
    text-align: center;
    padding: 45px 20px;
}

header h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
}


/* =========================
   MAIN CONTAINER
========================= */

.container {
    width: 85%;
    max-width: 1100px;
    margin: 30px auto;
}


/* =========================
   SECTIONS
========================= */

section {
    background-color: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

section h2 {
    color: #087ea4;
    margin-bottom: 18px;
    border-bottom: 2px solid #eeeeee;
    padding-bottom: 8px;
}

section h3 {
    color: #087ea4;
    margin-bottom: 8px;
}

section p {
    margin-bottom: 10px;
}


/* =========================
   FEATURES
========================= */

.features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.feature-card {
    background-color: #f1f9fc;
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid #159bb5;
    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.12);
}

.feature-card h3 {
    margin-bottom: 10px;
}


/* =========================
   TECHNOLOGIES
========================= */

.tech {
    display: inline-block;
    background-color: #e8f4f8;
    color: #087ea4;
    padding: 8px 15px;
    margin: 5px;
    border-radius: 20px;
    font-weight: bold;
}


/* =========================
   DESTINATIONS
========================= */

.destinations {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.destination {
    background-color: #f7fafb;
    padding: 18px;
    border-radius: 8px;
    border: 1px solid #e1e8eb;
    transition: 0.3s;
}

.destination:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
}

.destination h3 {
    margin-bottom: 8px;
}


/* =========================
   SCREENSHOTS
========================= */

.screenshots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.screenshots div {
    text-align: center;
}

.screenshots h3 {
    margin-bottom: 12px;
}

.screenshots img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #ddd;
    transition: 0.3s;
}

.screenshots img:hover {
    transform: scale(1.03);
}


/* =========================
   OBJECTIVE
========================= */

.objective {
    background-color: #eaf8f8;
    border-left: 5px solid #12aaa8;
}

.objective h2 {
    border-bottom: none;
}


/* =========================
   FUTURE ENHANCEMENTS
========================= */

section ul {
    padding-left: 25px;
}

section li {
    margin-bottom: 8px;
}


/* =========================
   FOOTER
========================= */

footer {
    background-color: #1f2933;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
}

footer p {
    margin: 5px;
}


/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 900px) {

    .features {
        grid-template-columns: repeat(2, 1fr);
    }

    .destinations {
        grid-template-columns: repeat(2, 1fr);
    }

    .screenshots {
        grid-template-columns: repeat(2, 1fr);
    }
}


@media (max-width: 600px) {

    header h1 {
        font-size: 28px;
    }

    header p {
        font-size: 16px;
    }

    .container {
        width: 92%;
    }

    .features,
    .destinations,
    .screenshots {
        grid-template-columns: 1fr;
    }

    section {
        padding: 20px;
    }
}
